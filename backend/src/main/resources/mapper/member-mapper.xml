<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.farmtech.smartfarm.member.mapper.MemberMapper">

    <resultMap id="memberResultMap" type="com.farmtech.smartfarm.member.dto.MemberDTO">
        <id     column="MEMBER_ID"          property="memberId"/>
        <result column="MEMBER_EMAIL"       property="memberEmail" />
        <result column="MEMBER_PASSWORD"    property="memberPw" />
        <result column="MEMBER_NAME"        property="memberName" />
        <result column="MEMBER_PHONE"       property="memberPhone" />
        <result column="MEMBER_BIRTH"       property="memberBirth" />
        <result column="MEMBER_ADDR"        property="memberAddr" />
        <result column="MEMBER_ADDR_DETAIL" property="memberAddrDetail" />
        <result column="MEMBER_ROLE"        property="memberRole"/>
        <result column="MEMBER_STATUS"      property="memberStatus"/>
        <result column="MEMBER_CREATED_AT"  property="memberCreatedAt"/>
    </resultMap>

    <insert id="insertMember">
        INSERT INTO MEMBER (
        MEMBER_EMAIL,
        MEMBER_PASSWORD,
        MEMBER_NAME,
        MEMBER_PHONE,
        MEMBER_BIRTH,
        MEMBER_ADDR,
        MEMBER_ADDR_DETAIL
        ) VALUES (
        #{memberEmail},
        #{memberPw},
        #{memberName},
        #{memberPhone},
        #{memberBirth},
        #{memberAddr},
        #{memberAddrDetail}
        )
    </insert>

    <select id="checkEmailDuplicate" resultType="int">
        SELECT COUNT(*)
        FROM MEMBER
        WHERE MEMBER_EMAIL = #{memberEmail}
    </select>

<!--  로그인 회원 정보 조회 쿼리  -->
    <select id="getLoginInfo" resultMap="memberResultMap">
        SELECT MEMBER_EMAIL
            , MEMBER_PASSWORD
            , MEMBER_ROLE
        FROM MEMBER
        WHERE MEMBER_EMAIL = #{memEmail}
    </select>

<!--  로그인 회원 정보 전체 조회 쿼리  -->
    <select id="getAllInfo" resultMap="memberResultMap">
        SELECT *
        FROM MEMBER
        WHERE MEMBER_EMAIL = #{memEmail}
    </select>

<!--  내 정보 수정 쿼리  -->
    <update id="setMemberInfo">
        UPDATE MEMBER
        SET
            MEMBER_NAME = #{memberName}
            , MEMBER_BIRTH = #{memberBirth}
            , MEMBER_PHONE = #{memberPhone}
            , MEMBER_ADDR = #{memberAddr}
            , MEMBER_ADDR_DETAIL = #{memberAddrDetail}
        WHERE MEMBER_EMAIL = #{memberEmail}
    </update>

<!--  비밀번호 수정 쿼리  -->
    <update id="setNewPw">
        UPDATE MEMBER
        SET
            MEMBER_PASSWORD = #{memberPw}
        WHERE MEMBER_EMAIL = #{memberEmail}
    </update>
</mapper>