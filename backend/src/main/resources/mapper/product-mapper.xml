<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.farmtech.smartfarm.product.mapper.ProductMapper">

    <!--ProductDTO resultMap-->
    <resultMap id="productResultMap" type="com.farmtech.smartfarm.product.dto.ProductDTO">
        <id     property="productId"        column="PRODUCT_ID"/>
        <result property="categoryId"       column="CATEGORY_ID"/>
        <result property="productName"      column="PRODUCT_NAME"/>
        <result property="productPrice"     column="PRODUCT_PRICE"/>
        <result property="productStock"     column="PRODUCT_STOCK"/>
        <result property="productDesc"      column="PRODUCT_DESC"/>
        <result property="productStatus"    column="PRODUCT_STATUS"/>
        <result property="productCreatedAt" column="PRODUCT_CREATED_AT"/>
        <collection property="productImageList" resultMap="productImageResultMap"></collection>
    </resultMap>

    <!--ProductImageDTO resultMap    -->
    <resultMap id="productImageResultMap" type="com.farmtech.smartfarm.product.dto.ProductImageDTO">
        <id     property="imageId"          column="IMAGE_ID"/>
        <result property="productId"        column="PRODUCT_ID"/>
        <result property="imageOriginName"  column="IMAGE_ORIGIN_NAME"/>
        <result property="imageSavedName"   column="IMAGE_SAVED_NAME"/>
        <result property="imageType"        column="IMAGE_TYPE"/>
        <result property="imageOrder"       column="IMAGE_ORDER"/>
    </resultMap>

    <!--ProductCategoryDTO resultMap-->
    <resultMap id="productCategoryMap" type="com.farmtech.smartfarm.product.dto.ProductCategoryDTO">
        <id property="categoryId" column="CATEGORY_ID"/>
        <result property="categoryName" column="CATEGORY_NAME"/>
    </resultMap>

    <!-- ProductListDTO resultMap -->
    <resultMap id="productListMap" type="com.farmtech.smartfarm.product.dto.ProductListDTO">
        <id     column="PRODUCT_ID"         property="productId" />
        <result column="CATEGORY_ID"        property="categoryId" />
        <result column="PRODUCT_NAME"       property="productName" />
        <result column="PRODUCT_PRICE"      property="productPrice" />
        <result column="PRODUCT_STOCK"      property="productStock" />
        <result column="PRODUCT_STATUS"     property="productStatus" />
        <result column="MAIN_IMAGE"         property="mainImage" />
        <result column="SALES_COUNT"        property="salesCount" />
    </resultMap>

    <!--상품 등록 (DB AUTO_INCREMENT, 생성된 ID를 productId에 자동 주입)-->
    <insert id="insertProduct" useGeneratedKeys="true" keyProperty="productId">
        INSERT INTO PRODUCT (
            CATEGORY_ID, PRODUCT_NAME, PRODUCT_PRICE,
            PRODUCT_STOCK, PRODUCT_DESC, PRODUCT_STATUS
        ) VALUES (
            #{categoryId}, #{productName}, #{productPrice},
            #{productStock}, #{productDesc}, #{productStatus}
        )
    </insert>

    <!--상품 이미지 등록-->
    <insert id="insertImage">
        INSERT INTO PRODUCT_IMAGE (
            PRODUCT_ID,
            IMAGE_ORIGIN_NAME,
            IMAGE_SAVED_NAME,
            IMAGE_TYPE,
            IMAGE_ORDER
        ) VALUES
        <foreach collection="imgList" item="img" separator=",">
            (
                #{img.productId},
                #{img.imageOriginName},
                #{img.imageSavedName},
                #{img.imageType},
                #{img.imageOrder}
            )
        </foreach>
    </insert>

    <!--카테고리 조회-->
    <select id="selectCategory" resultMap="productCategoryMap">
        SELECT *
        FROM CATEGORY
    </select>

    <!-- 상품 목록 조회 (V_PRODUCT_LIST VIEW 사용) -->
    <select id="selectProductList" resultMap="productListMap">
        SELECT
            PRODUCT_ID,
            CATEGORY_ID,
            PRODUCT_NAME,
            PRODUCT_PRICE,
            PRODUCT_STOCK,
            PRODUCT_STATUS,
            MAIN_IMAGE,
            SALES_COUNT
        FROM V_PRODUCT_LIST
        <if test="keyword != null and keyword != ''">
            WHERE PRODUCT_NAME LIKE CONCAT('%', #{keyword}, '%')
        </if>
        <choose>
            <!-- 판매량 높은 순 -->
            <when test="sort == 'sales_desc'">
                ORDER BY SALES_COUNT DESC
            </when>
            <!-- 가격 높은 순 -->
            <when test="sort == 'price_desc'">
                ORDER BY PRODUCT_PRICE DESC
            </when>
            <!-- 가격 낮은 순 -->
            <when test="sort == 'price_asc'">
                ORDER BY PRODUCT_PRICE ASC
            </when>
            <!-- 기본값: 등록 순 (PRODUCT_ID 내림차순) -->
            <otherwise>
                ORDER BY PRODUCT_ID DESC
            </otherwise>
        </choose>
    </select>

    <!-- 매니저 상품 전체 목록 조회 (V_MANAGER_PRODUCT_LIST VIEW 사용, 상태 필터 없음) -->
    <select id="selectProductListManager" resultMap="productListMap">
        SELECT
            PRODUCT_ID,
            CATEGORY_ID,
            PRODUCT_NAME,
            PRODUCT_PRICE,
            PRODUCT_STOCK,
            PRODUCT_STATUS,
            MAIN_IMAGE,
            SALES_COUNT
        FROM V_MANAGER_PRODUCT_LIST
        ORDER BY PRODUCT_ID DESC
    </select>

    <!--  상품 상세 정보 조회  -->
    <select id="getProductDetail" resultMap="productResultMap">
        SELECT *
        FROM PRODUCT P, PRODUCT_IMAGE I
        WHERE P.PRODUCT_ID = I.PRODUCT_ID
        AND P.PRODUCT_ID = #{productId}
    </select>

    <!--  상품 삭제 (단건) -->
    <delete id="deleteProduct">
        DELETE FROM PRODUCT
        WHERE PRODUCT_ID = #{productId}
    </delete>

    <!--  상품 이미지 삭제-->
    <delete id="deleteProductImage">
        DELETE FROM PRODUCT_IMAGE
        WHERE PRODUCT_ID = #{productId}
    </delete>

    <update id="updateProduct">
        UPDATE PRODUCT
        SET CATEGORY_ID    = #{categoryId},
            PRODUCT_NAME   = #{productName},
            PRODUCT_PRICE  = #{productPrice},
            PRODUCT_STOCK  = #{productStock},
            PRODUCT_STATUS = #{productStatus}
        WHERE PRODUCT_ID = #{productId}
    </update>

    <!-- AI 셰프 상품 매칭용 - 활성 상품 전체 조회 -->
    <select id="selectActiveProducts" resultMap="productListMap">
        SELECT
            PRODUCT_ID,
            CATEGORY_ID,
            PRODUCT_NAME,
            PRODUCT_PRICE,
            PRODUCT_STOCK,
            PRODUCT_STATUS,
            MAIN_IMAGE,
            SALES_COUNT
        FROM V_PRODUCT_LIST
        WHERE PRODUCT_STATUS = 'ACTIVE'
          AND PRODUCT_STOCK > 0
        ORDER BY PRODUCT_ID DESC
    </select>
</mapper>
